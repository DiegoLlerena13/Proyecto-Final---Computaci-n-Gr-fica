MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1021653233}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 627664ce16ed99440ac7be4627ecc13b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EcoDexManager
  animales:
  - nombre: Vizcacha andina
    nombreCientifico: Lagidium viscacia
    habitat: "Zonas rocosas altoandinas, laderas y \xE1reas de monta\xF1a."
    alimentacion: "Pastos, hojas, brotes y vegetaci\xF3n de zonas andinas."
    estado: Especie silvestre andina.
    amenazas: "P\xE9rdida de h\xE1bitat, actividad humana y reducci\xF3n de zonas
      naturales."
    datoCurioso: Se parece a un conejo, pero pertenece al grupo de los roedores andinos
      y se mueve muy bien entre rocas.
  - nombre: "Ping\xFCino de Humboldt"
    nombreCientifico: Spheniscus humboldti
    habitat: "Costas del Per\xFA y Chile, especialmente zonas rocosas cercanas al
      mar."
    alimentacion: "Peces peque\xF1os y organismos marinos."
    estado: "Especie vulnerable seg\xFAn su poblaci\xF3n y zona."
    amenazas: "Contaminaci\xF3n marina, pesca excesiva y alteraci\xF3n de zonas de
      reproducci\xF3n."
    datoCurioso: No puede volar, pero nada con gran agilidad usando sus alas como
      aletas.
  - nombre: Taruca andina
    nombreCientifico: Hippocamelus antisensis
    habitat: "Zonas altoandinas, monta\xF1as, pajonales y \xE1reas rocosas."
    alimentacion: "Pastos, hojas, arbustos y vegetaci\xF3n de altura."
    estado: "Especie amenazada en varias zonas de distribuci\xF3n."
    amenazas: "P\xE9rdida de h\xE1bitat, caza y fragmentaci\xF3n de ecosistemas."
    datoCurioso: "Tambi\xE9n es conocida como venado andino y est\xE1 adaptada a
      vivir en zonas de altura."
  - nombre: Gallito de las rocas
    nombreCientifico: Rupicola peruvianus
    habitat: "Bosques h\xFAmedos de monta\xF1a y zonas de selva alta.\t"
    alimentacion: "Frutos e insectos peque\xF1os."
    estado: "Ave representativa del Per\xFA."
    amenazas: "P\xE9rdida de bosques y alteraci\xF3n de su h\xE1bitat."
    datoCurioso: "El macho tiene un color naranja intenso y es considerado ave nacional
      del Per\xFA."
  - nombre: "Serpiente amaz\xF3nica"
    nombreCientifico: Boa constrictor
    habitat: "Bosques tropicales, zonas h\xFAmedas y \xE1reas cercanas a r\xEDos."
    alimentacion: "Peque\xF1os mam\xEDferos, aves y otros animales peque\xF1os."
    estado: "Variable seg\xFAn la especie y la zona."
    amenazas: "Destrucci\xF3n del bosque, miedo humano y comercio ilegal."
    datoCurioso: Las serpientes ayudan a controlar poblaciones de otros animales
      dentro del ecosistema.
  - nombre: Perrito rescatado
    nombreCientifico: Canis lupus familiaris
    habitat: Refugios, hogares y espacios de cuidado animal.
    alimentacion: Alimento balanceado y agua limpia.
    estado: "Animal dom\xE9stico en situaci\xF3n de cuidado o rescate."
    amenazas: "Abandono, maltrato y falta de atenci\xF3n veterinaria."
    datoCurioso: "Los perros pueden formar fuertes v\xEDnculos con las personas y
      responder positivamente al cuidado."
  txtNombre: {fileID: 349489498}
  txtNombreCientifico: {fileID: 824149078}
  txtHabitat: {fileID: 1054038638}
  txtAlimentacion: {fileID: 1602466895}
  txtEstado: {fileID: 843249036}
  txtAmenazas: {fileID: 689232634}
  txtDatoCurioso: {fileID: 1322642583}
